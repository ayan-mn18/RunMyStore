# Copy to .env. "Ask RunMyStore" runs on an AgenticOrg agent; without an API key and agent id it keeps its prepared demo answers.
# WARNING: VITE_* values are compiled into the browser bundle. Use a restricted-scope key on private deployments only.

VITE_AGENTICORG_API_KEY=
# Pine Labs hackathon: https://agenticorg.hackathon.pinelabs.com
VITE_AGENTICORG_BASE_URL=https://app.agenticorg.ai
# The browser calls /api/v1 on its own origin and Vite proxies it to the base URL (AgenticOrg blocks CORS).
# true = call the base URL directly instead (only if the deployment allows CORS).
VITE_AGENTICORG_DIRECT=false

# The agent's UUID. Its system prompt must reply with {"reply": "...", "actions": [...]} (see src/agent.ts for the action types).
VITE_RMS_AGENT_ID=
